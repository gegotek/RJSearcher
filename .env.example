# Skopiuj do .env i wczytaj np.:  set -a; source .env; set +a
# NIGDY nie commituj prawdziwych kluczy (.env jest w .gitignore).

# --- LLM (API zgodne z OpenAI) ---
# OpenAI:
OPENAI_API_KEY=
# Lokalnie przez Ollama (klucz niepotrzebny):
# RJ_LLM_BASE_URL=http://localhost:11434/v1
# RJ_LLM_MODEL=llama3.1
# RJ_LLM_MODEL=gpt-4o-mini

# --- Powiadomienia (Discord / Slack webhook) ---
# RJ_WEBHOOK_URL=

# --- Ścieżki / adres ---
# RJ_DB=rjsearcher.db
# RJ_PROFILE=profile.toml
# RJ_ADDR=127.0.0.1:3000
